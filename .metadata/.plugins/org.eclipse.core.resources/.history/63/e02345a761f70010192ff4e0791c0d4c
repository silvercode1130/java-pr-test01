<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.db.dao.VisitDao">

 <!-- 전체조회 -->
  <select id="selectList" resultType="Visit">
  	select * from visit order by idx desc
  </select>
  
 <!-- 특정 idx VisitVo 1개 조회 -->
 <select id="selectOne" parameterType="int" resultType="visit">
 	select * from visit where idx= #{ idx }
 <!--					mybatis parameter 표현은 #{변수명} 으로 표현
 						parameter 가 단일 type(int, String) 이면 변수명을 아무거나 적어도 됨
 						일반적으로 column 명을 기록한다 -->
 </select>

 <!-- 추가 -->
 <insert id="insert" parameterType="visit" res >
 	insert into visit values(seq_visit_idx.nextVal,	?, ?, ?, ?, sysdate, sysdate
 </insert>

</mapper>












