<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bbs.dao.boardDao">

 <!-- 전체조회 -->
  <select id="selectList" resultType="board">
  	select * from board
  </select>

<!-- b_idx이용한 BoardVo 객체 1개 얻기 -->
<select id="selectOneFromIdx" parameterType="int"
								resultType="board">
	select * from board where b_idx=#{ b_idx }

</select>

<!-- mem_id이용한 boardVo 객체 1개 얻기 -->

<select id="selectOneFromId" parameterType="String"
								resultType="board">
	select * from board where mem_id=#{ mem_id }

</select>

<!-- 추가 -->
<insert id="insert" parameterType="board">

insert into board values(
							seq_board_mem_idx.nextVal,
 							#{mem_name},
							#{mem_id} ,							
							#{mem_pwd} ,							
							#{mem_email} ,							
							#{mem_tel} ,							
							#{mem_zipcode} ,							
							#{mem_addr} ,							
							#{mem_ip} ,							
 							 default,
 							 default
 							 )
</insert>

<!-- 수정 -->
<update id="update" parameterType="board">
update board set 	mem_name	=#{mem_name},
					mem_pwd		=#{mem_pwd},
					mem_email	=#{mem_email},
					mem_tel		=#{mem_tel},
				  	mem_zipcode	=#{mem_zipcode},
				  	mem_addr	=#{mem_addr},
				  	mem_ip		=#{mem_ip},
				  	mem_role	=#{mem_role}  
	where mem_idx=#{mem_idx}
</update>

<!-- 삭제 -->
<delete id="delete" parameterType="int">
	delete from board where mem_idx=#{ mem_idx }
</delete>
</mapper>












