package com.example.db.controller;

import java.io.File;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.multipart.MultipartFile;
import jakarta.servlet.ServletContext;

@Controller
public class FileUploadController {
	
	@Autowired
	ServletContext application;
	// 웹경로를 절대경로로 구할 수 있는 객체
	
	// upload1.do?title=제목&photo=a.jpg (post 방식이라 이렇게 나오진 않지만 parameter 2개 넘어옴)
	@RequestMapping("/upload1.do")
	public String upload1(	String title,
							@RequestParam MultipartFile photo,
							Model model) throws Exception, IOException {
							// 반드시 parameter 이름으로 받아야함!
							// multipartResolver가 받아둔 업로드 파일을 ds에게 넘겨달라고 요청
		
		// Web 경로 -> 절대경로 구하기
		String webPath = "/images/";
		String absPath = application.getRealPath(webPath);	// application 에게 절대경로 요청
		System.out.println(absPath);
		
		String filename = "no_file";
		// 업로드된 이미지가 있으면
		if(!photo.isEmpty()) {
			
			// 업로드된 파일명 얻어오기
			filename = photo.getOriginalFilename();
			// 웹서비스이므로 같은 이름으로 이미지가 등록될 수 있다
			// 동일한 파일명이 덮어쓰기 되지 않도록 이름변경 시켜줘야함
			
			File f = new File(absPath, filename);			// 이 경로(absPath)에 있는 이 파일을 저장한다
			// 업로드위치에 동일한 파일명이 있는지 체크
			if(f.exists()) {
				long tm = System.currentTimeMillis();		// 현재 시간을 millisecond로 구함
				//			filename = 시간_filename
				filename = String.format("%d_%s", tm, filename);
				
				f = new File(absPath, filename);
			}
			
			// 임시공간의 파일을 복사
			photo.transferTo(f);
			
		}// end:if(!photo.isEmpty())
		
		// model 이용해 request binding
		model.addAttribute("title", title);
		model.addAttribute("filename", filename);
		
		return "result1";
	}
	
	// upload1.do?title=제목&photo1=a.jpg&photo2=b.jpg (parameter 3개)
	@RequestMapping("/upload2.do")
	public String upload1(	String title,
							@RequestParam(name="photo") MultipartFile [] photo_array,
							// 반드시 parameter 이름(photo)의 배열로 받아야함!
							// 그냥 photo_array라고 쓰면 에러뜸 -> requestParam에게 가져올 변수명 알려줘야함
							Model model) throws Exception, IOException {
		
		// 절대경로 구하기
		String webPath = "/images/";
		String absPath = application.getRealPath(webPath);	// application 에게 절대경로 요청
		
		String filename1 = "no_file";
		String filename2 = "no_file";
		
		// 배열이므로 for문 돌리기
		for(int i=0; i<photo_array.length; i++) {
			
			MultipartFile photo = photo_array[i];
			
			// 업로드된 이미지가 있으면
			if(!photo.isEmpty()) {
				
				// 업로드된 파일명 얻어오기
				String filename = photo.getOriginalFilename();
				// 웹서비스이므로 같은 이름으로 이미지가 등록될 수 있다
				// 동일한 파일명이 덮어쓰기 되지 않도록 이름변경 시켜줘야함
				
				File f = new File(absPath, filename);			// 이 경로(absPath)에 있는 이 파일을 저장한다
				// 업로드위치에 동일한 파일명이 있는지 체크
				if(f.exists()) {
					long tm = System.currentTimeMillis();		// 현재 시간을 millisecond로 구함
					//			filename = 시간_filename
					filename = String.format("%d_%s", tm, filename);
					
					f = new File(absPath, filename);
				}
				
				// 임시공간의 파일을 복사
				photo.transferTo(f);
				
				if(i==0) filename1 = filename;
				if(i==1) filename2 = filename;
			
			}// end:for
		
		}
		// model 이용해 request binding
		model.addAttribute("title", title);
		model.addAttribute("filename1", filename1);
		model.addAttribute("filename2", filename2);
		
		return "result2";
	}
	
	// upload1.do?title=제목&photo1=a.jpg&photo2=b.jpg (parameter 3개)
	@RequestMapping("/upload3.do")
	public String upload1(	String title,
							@RequestParam(name="photo") List<MultipartFile> photo_list,
							// 반드시 parameter 이름(photo)의 배열로 받아야함!
							// arrayList로 받아서 파일개수(배열길이)를 마음대로 할 수 있음
							Model model) throws Exception, IOException {
		
		// 절대경로 구하기
		String webPath = "/images/";
		String absPath = application.getRealPath(webPath);	// application 에게 절대경로 요청
		
		// 업로드된 파일명을 저장할 List
		List<String> filename_list = new ArrayList<String>();
		
		// 배열이므로 for문 돌리기
		for(MultipartFile photo : photo_list) {
			
			// 업로드된 이미지가 있으면
			if(!photo.isEmpty()) {
				
				// 업로드된 파일명 얻어오기
				String filename = photo.getOriginalFilename();
				// 웹서비스이므로 같은 이름으로 이미지가 등록될 수 있다
				// 동일한 파일명이 덮어쓰기 되지 않도록 이름변경 시켜줘야함
				
				File f = new File(absPath, filename);			// 이 경로(absPath)에 있는 이 파일을 저장한다
				// 업로드위치에 동일한 파일명이 있는지 체크
				if(f.exists()) {
					long tm = System.currentTimeMillis();		// 현재 시간을 millisecond로 구함
					//			filename = 시간_filename
					filename = String.format("%d_%s", tm, filename);
					
					f = new File(absPath, filename);
				}
				
				// 임시공간의 파일을 복사
				photo.transferTo(f);
				
				// 업로드된 파일명을 List 에 저장
				filename_list.add(filename);
				
			}// end:if(!photo.isEmpty())
			
			// model 이용해 request binding
			model.addAttribute("title", title);
			model.addAttribute("filename_list", filename_list);
		
		return "result3";
	}
}
