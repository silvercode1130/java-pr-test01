package com.example.db.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;

import com.example.db.dao.VisitDao;
import com.example.db.vo.VisitVo;

@Controller
public class VisitController {
	// 데이터베이스에서 Visit 정보를 조회하는 컨트롤러
	// 컨트롤러는 VisitDao 의 사원정보 조회기능이 필요함
	// VisitController 는 VisitDao 를 의존한다(dependency) 고 지정해줘야함
	// 이것을 DI(Dependency Injection, 의존성 주입) 이라고 한다
	
	// DI (Dependency Injection, 의존성 주입)
	@Autowired
	VisitDao visitDao;
	
/*	의존성 주입의 여러 방법

	// 1. Constructor Injection (생성자 의존성 주입)
	@Autowired
	public VisitController(VisitDao visitDao) {
		super();
		this.visitDao = visitDao;
	}
	
	->	생성자 방식은 디펜던시가 여러개일 때 유용함
		: 한 번에 의존요소들을 호출할 수 있음!
	
	
	// 2. Setter Injection (setter 의존성 주입)
	@Autowired
	public void setVisitDao(VisitDao visitDao) {
		this.visitDao = visitDao;
	}
*/


	@RequestMapping("/visit/list.do")
	public String selectList(Model model) {
		
		// 데이터 얻어오기
		List<VisitVo> list = visitDao.selectList();
		
		// Request Binding
		model.addAttribute("list", list);
		
		return "visit/visit_list";
	}
	
	@RequestMapping("/visit/insert_form.do")
	public String insert_form() {
		
		return "visit/visit_insert_form";
	}
	
}
