package com.example.db.controller;

import java.io.File;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.multipart.MultipartFile;
import com.example.db.config.MyBatisConfig;
import jakarta.servlet.ServletContext;

@Controller
public class FileUploadController {

    private final MyBatisConfig myBatisConfig;
	
	@Autowired
	ServletContext application;

    FileUploadController(MyBatisConfig myBatisConfig) {
        this.myBatisConfig = myBatisConfig;
    }	// 웹경로를 절대경로로 구할 수 있는 객체
	
	// upload1.do?title=제목&photo=a.jpg (post 방식이라 이렇게 나오진 않지만 parameter 2개 넘어옴)
	@RequestMapping("/upload1.do")
	public String upload1(String title, @RequestParam MultipartFile photo) {
										// 반드시 parameter 이름으로 받아야함!
										// multipartresolver가 받아둔 업로드 파일을 ds에게 넘겨달라고 요청
		
		String webPath = "/images/";
		String absPath = application.getRealPath(webPath);	// application 에게 절대경로 요청
		System.out.println(absPath);
		
		String filename = "no_file";
		// 업로드된 이미지가 있으면
		if(!photo.isEmpty()) {
			// 업로드된 파일명 얻어오기
			filename = photo.getOriginalFilename();
			// 웹서비스이므로 같은 이름으로 이미지가 등록될 수 있음
			// 그러므로 업로드 위치에 동일한 파일명이 존재할 경우 
			
			File f = new File(absPath, filename);			// 이 경로(absPath)에 있는 이 파일을 저장한다
			// 이미 업로드위치에 동일한 파일명이 있는지 체크
			if(f.exists())
				long tm = System.currentTimeMillis();		// 현재 시간을 millisecond로 구함
		}
		
		return "result1";
	}
}
