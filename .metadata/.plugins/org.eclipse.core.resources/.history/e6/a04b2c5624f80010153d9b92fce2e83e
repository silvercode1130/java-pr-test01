package com.example.db.controller;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.ResponseBody;

import com.example.db.dao.VisitDao;
import com.example.db.vo.VisitVo;

import jakarta.servlet.ServletContext;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpSession;

@Controller
public class VisitController {
	// 데이터베이스에서 Visit 정보를 조회하는 컨트롤러
	// 컨트롤러는 VisitDao 의 사원정보 조회기능이 필요함
	// VisitController 는 VisitDao 를 의존한다(dependency) 고 지정해줘야함
	// 이것을 DI(Dependency Injection, 의존성 주입) 이라고 한다
	
	// DI (Dependency Injection, 의존성 주입)
	@Autowired
	VisitDao visitDao;
	
	// 전역변수로 선언
	// 매 요청마다 injection(주입)
	// DS 가 호출될 때 마다 새로운 값으로 갱신된다
	@Autowired
	HttpServletRequest request;
	
	@Autowired
	HttpSession session;
	
	@Autowired
	ServletContext application;
	
	
/*	의존성 주입의 여러 방법

	// 1. Constructor Injection (생성자 의존성 주입)
	@Autowired
	public VisitController(VisitDao visitDao) {
		super();
		this.visitDao = visitDao;
	}
	
	->	생성자 방식은 디펜던시가 여러개일 때 유용함
		: 한 번에 의존요소들을 호출할 수 있음!
	
	
	// 2. Setter Injection (setter 의존성 주입)
	@Autowired
	public void setVisitDao(VisitDao visitDao) {
		this.visitDao = visitDao;
	}
*/
	// /visit/list.do	: 전체조회
	// /visit/list.do?search=all&search_text=
	// /visit/list.do?search=name&search_text=길동
	// /visit/list.do?search=content&search_text=길동
	// /visit/list.do?search=name_content&search_text=길동
	
	// ===== 조회
	@RequestMapping("/visit/list.do")
	public String list( @RequestParam(name="search", defaultValue="all") String search,
							  String search_text, Model model) {
		
//		if(search==null) search="all";
		
		// 검색조건을 담을 Map
		Map<String, Object> map = new HashMap<String, Object>();
		
		// 검색을 하면 map 안에 아래 요소가 담기는 것
		// 전체 검색을 하면 map 안에 아무것도 없다! (map.put이 없으므로)
		// 이렇게 맵으로 포장된 값은 어디로 가는걸까? -> mapper(마이바티스)로!
		if(search.equals("name")) {
			// 이름으로 검색
			map.put("name", search_text);
			
		}else if(search.endsWith("content")) {
			// 내용으로 검색
			map.put("content", search_text);
			
		}else if(search.endsWith("name_content")) {
			// 이름+내용으로 검색
			map.put("name", search_text);
			map.put("content", search_text);
		}
		
		// 데이터 얻어오기
		List<VisitVo> list = visitDao.selectConditionList();

		
		// Request Binding
		model.addAttribute("list", list);
		
		return "visit/visit_list";
	}
	
	// ===== 입력폼 띄우기
	@RequestMapping("/visit/insert_form.do")
	public String insert_form() {
		
		return "visit/visit_insert_form";
	}
	
	// ===== 등록
	// /visit/insert.do?name=홍길동&content=안녕하세요&pwd=1234
	@RequestMapping("/visit/insert.do")
	public String insert(VisitVo vo) {
		//				 ㄴ parameter 받아서 VisitVo 로 포장해줘, request 받아서 ip 정보 얻어줘
		
		// content : \n -> <br> 변경
		String content = vo.getContent().replaceAll("\n", "<br>");
		vo.setContent(content);
		
		// ip 얻으려면 request 를 얻어야함
		// 요구사항(메서드 매개변수)에 HttpServletRequest request
		String ip = request.getRemoteAddr();
		vo.setIp(ip);
		
		// DB insert
		int res = visitDao.insert(vo);
		
		return "redirect:list.do";
		// 리다이렉트에 대한 정보를 DispatcherServlet 에게
		// response.sendRedirect("list.do"); 하도록 정보제공
		// 아무 정보없이 그냥 주면 view 로 인식한다
	}
	
	// ===== 비밀번호 체크
	// /visit/check_pwd.do?idx=1&c_pwd=1234
	@RequestMapping("/visit/check_pwd.do")
	@ResponseBody
	public Map<String, Boolean> check_pwd(int idx, String c_pwd) {
		
		VisitVo vo = visitDao.selectOne(idx);
		
		boolean bResult = false;
		boolean bExist	= (vo!=null);
		
		// 비밀번호 맞는지 체크
		if(vo!=null) {
			bResult = vo.getPwd().equals(c_pwd);
		}
		
		Map<String, Boolean> map = new HashMap<String, Boolean>();
		
		map.put("result", bResult);
		map.put("exist", bExist);
		
		return map;	// {"result":true, "exist":true}
	}
	
	// DS(Dispatcher Servlet)가 호출한 method 에서 반환되는 유형
	// 1. ViewName : "Hello"
	// 2. Redirect : "redirect:list.do"
	// 3. ResponseBody : String 인 경우 -> "해당내용" view를 거치지 말고 그냥 전송해라
	//					 객체(배열, 리스트, map...) -> JSON 으로 변환해서 응답
	
	
	// ===== 수정폼 띄우기
	// /visit/modify_form.do?idx=142
	@RequestMapping("/visit/modify_form.do")
	public String modify_form(int idx, Model model) {
		
		VisitVo vo = visitDao.selectOne(idx);
		
		// <br> -> \n 변경
		String content = vo.getContent().replaceAll("<br>", "\n");
		vo.setContent(content);
		
		// request binding (model 통해서)
		model.addAttribute("vo", vo);
		
		return "visit/visit_modify_form";
	}	
	
	
	// ===== 수정
	@RequestMapping("/visit/modify.do")
	public String modify(VisitVo vo) {
	//					parameter 받아서 VisitVo 포장해 달라는 뜻
		
		// \n -> <br> 변경
		String content = vo.getContent().replaceAll("\n", "<br>");
		vo.setContent(content);
		
		String ip = request.getRemoteAddr();
		vo.setIp(ip);

		// DB update
		int res = visitDao.update(vo);
		
		return "redirect:list.do";
	}
	
	// ===== 삭제
	// /visit/delete.do?idx=1&c_pwd=1234
	@RequestMapping("/visit/delete.do")
	public String delete(int idx) {
		
		int res = visitDao.delete(idx);
		
		return "redirect:list.do";
	}
}
