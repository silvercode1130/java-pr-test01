org.eclipse.jdt.ui.text.custom_templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="true" context\="java" deleted\="false" description\="action \uB0B4 \uD3EC\uC6CC\uB4DC" enabled\="true" name\="_forward_servlet">import jakarta.servlet.RequestDispatcher;&\#13;\r\nimport jakarta.servlet.ServletException;&\#13;\r\nimport jakarta.servlet.annotation.WebServlet;&\#13;\r\nimport jakarta.servlet.http.HttpServlet;&\#13;\r\nimport jakarta.servlet.http.HttpServletRequest;&\#13;\r\nimport jakarta.servlet.http.HttpServletResponse;&\#13;\r\nimport java.io.IOException;&\#13;\r\n&\#13;\r\n/**&\#13;\r\n * Servlet implementation class ${primary_type_name}&\#13;\r\n */&\#13;\r\n@WebServlet("/${cursor}")&\#13;\r\npublic class ${primary_type_name} extends HttpServlet {&\#13;\r\n\tprivate static final long serialVersionUID \= 1L;&\#13;\r\n&\#13;\r\n\t/**&\#13;\r\n\t * @see HttpServlet\#service(HttpServletRequest request, HttpServletResponse response)&\#13;\r\n\t */&\#13;\r\n\tprotected void service(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {&\#13;\r\n\t\t&\#13;\r\n\t\t// \uBAA9\uB85D \uC694\uCCAD&\#13;\r\n&\#13;\r\n\t\t// Request Binding&\#13;\r\n&\#13;\r\n\t\t// Dispatcher(forward)&\#13;\r\n\t\tString forward_page \= "[\uD3EC\uC6CC\uB4DC\uD398\uC774\uC9C0].jsp";&\#13;\r\n\t\tRequestDispatcher disp \= request.getRequestDispatcher(forward_page);&\#13;\r\n\t\tdisp.forward(request, response);&\#13;\r\n\t}&\#13;\r\n&\#13;\r\n}</template><template autoinsert\="true" context\="java" deleted\="false" description\="\uC2F1\uAE00\uD1A4 \uD328\uD134" enabled\="true" name\="_singleton">// Single-ton pattern \: \uAC1D\uCCB4\uB97C 1\uAC1C\uB9CC \uC0DD\uC131\uD574\uC11C \uC0AC\uC6A9\uD558\uB294 \uB514\uC790\uC778 \uD328\uD134&\#13;\r\n\t// \uC778\uC2A4\uD134\uC2A4 \uC7A0\uAE08&\#13;\r\n\tprivate static ${primary_type_name} single\=null;&\#13;\r\n\t&\#13;\r\n\t// \uC0DD\uC131\uC790 \uC7A0\uAE08&\#13;\r\n\tprivate ${primary_type_name}() {}&\#13;\r\n\t&\#13;\r\n\t// \uC811\uADFC \uAC00\uB2A5\uD55C get\uBA54\uC11C\uB4DC&\#13;\r\n\tpublic static ${primary_type_name} getInstance() {&\#13;\r\n\t\tif( single \=\= null)&\#13;\r\n\t\t\tsingle \= new ${primary_type_name}();&\#13;\r\n\t\treturn single;&\#13;\r\n\t}</template><template autoinsert\="true" context\="java" deleted\="false" description\="dao \uB0B4 \uC870\uD68C \uBA54\uC11C\uB4DC" enabled\="true" name\="_selectList">// \uC870\uD68C \uBA54\uC11C\uB4DC&\#13;\r\n\tpublic List&lt;${argType}&gt; selectList(){&\#13;\r\n\t\t&\#13;\r\n\t\t// \uB370\uC774\uD130\uB97C \uB2F4\uC744 vo \uB9AC\uC2A4\uD2B8 \uC0DD\uC131&\#13;\r\n\t\tList&lt;${argType}&gt; list \= new ArrayList&lt;${argType}&gt;();&\#13;\r\n\t\t&\#13;\r\n\t\tConnection \t\t\tconn \t\= null;&\#13;\r\n\t\tPreparedStatement \tpstmt\t\= null;\t// Statement \uB97C \uC0C1\uC18D\uBC1B\uC740 \uAC1D\uCCB4&\#13;\r\n\t\tResultSet \t\t\trs\t\t\= null;&\#13;\r\n\t\t&\#13;\r\n\t\tString\t\t\t\tsql\t\t\= "select * from [\uD14C\uC774\uBE14\uBA85]";&\#13;\r\n\t\t&\#13;\r\n\t\ttry {&\#13;\r\n\t\t\t// 1. Connection \uC5BB\uC5B4\uC624\uAE30&\#13;\r\n\t\t\tconn\t\= DBService.getInstance().getConnection();&\#13;\r\n\t\t\t&\#13;\r\n\t\t\t// 2. PreparedStatement \uC5BB\uC5B4\uC624\uAE30&\#13;\r\n\t\t\tpstmt\t\= conn.prepareStatement(sql);\t// \uBA54\uC11C\uB4DC\uC774\uAE30 \uB54C\uBB38\uC5D0 prepare&\#13;\r\n\t\t\t&\#13;\r\n\t\t\t// 3. ResultSet \uC5BB\uC5B4\uC624\uAE30&\#13;\r\n\t\t\trs\t\t\= pstmt.executeQuery(sql);&\#13;\r\n\t\t\t&\#13;\r\n\t\t\twhile(rs.next()) {&\#13;\r\n\t\t\t\t${argType} vo \= new ${argType}();&\#13;\r\n\t\t\t\t&\#13;\r\n\t\t\t\t// rs\uAC00 \uAC00\uB9AC\uD0A4\uACE0 \uC788\uB294 \uCEEC\uB7FC\uAC12\uC744 \uC5BB\uC5B4\uC640\uC11C vo \uC5D0 \uB123\uAE30&\#13;\r\n\t\t\t\t&\#13;\r\n\t\t\t\t&\#13;\r\n\t\t\t\t// list \uC5D0 \uCD94\uAC00&\#13;\r\n\t\t\t\tlist.add(vo);&\#13;\r\n\t\t\t\t&\#13;\r\n\t\t\t} // end \: while&\#13;\r\n\t\t\t&\#13;\r\n\t\t} catch (Exception e) {&\#13;\r\n\t\t\t// TODO\: handle exception&\#13;\r\n\t\t\te.printStackTrace();&\#13;\r\n\t\t} finally {\t// \uC608\uC678 \uC720\uBB34\uC640 \uAD00\uACC4\uC5C6\uC774 \uBB34\uC870\uAC74 \uC218\uD589\uB418\uB294 \uCF54\uB4DC&\#13;\r\n\t\t\t\t&\#13;\r\n\t\t\t\t// alt+shift+z\t\: \uBE14\uB85D\uC73C\uB85C try/catch \uC9C0\uC815&\#13;\r\n\t\t\t\ttry {&\#13;\r\n\t\t\t\t\t// \uC5F4\uB9B0 \uC5ED\uC21C\uC73C\uB85C \uB2EB\uAE30&\#13;\r\n\t\t\t\t\tif(rs\!\=null)\trs.close();&\#13;\r\n\t\t\t\t\tif(pstmt\!\=null)\tpstmt.close();&\#13;\r\n\t\t\t\t\tif(conn\!\=null)\tconn.close();&\#13;\r\n\t\t\t\t} catch (SQLException e) {&\#13;\r\n\t\t\t\t\t// TODO Auto-generated catch block&\#13;\r\n\t\t\t\t\te.printStackTrace();&\#13;\r\n\t\t\t\t}&\#13;\r\n\t\t}&\#13;\r\n\t\t&\#13;\r\n\t\treturn list;&\#13;\r\n\t} // end \: selectList()</template><template autoinsert\="true" context\="java" deleted\="false" description\="" enabled\="true" name\="_delete">\t// \uC0AD\uC81C&\#13;\r\n\tpublic int delete(int idx) {&\#13;\r\n&\#13;\r\n\t\tint res \= 0;&\#13;\r\n&\#13;\r\n\t\tConnection conn \= null;&\#13;\r\n\t\tPreparedStatement pstmt \= null;&\#13;\r\n&\#13;\r\n\t\t//                                             1 &lt;- pstmt parameter index&\#13;\r\n\t\tString sql \= "delete from [\uD14C\uC774\uBE14\uBA85] where idx\=?";&\#13;\r\n&\#13;\r\n\t\ttry {&\#13;\r\n\t\t\t//1.Connection \uC5BB\uC5B4\uC624\uAE30&\#13;\r\n\t\t\tconn \= DBService.getInstance().getConnection();&\#13;\r\n&\#13;\r\n\t\t\t//2.PreparedStatement \uC5BB\uC5B4\uC624\uAE30&\#13;\r\n\t\t\tpstmt \= conn.prepareStatement(sql);&\#13;\r\n\t\t\t&\#13;\r\n\t\t\t//3.pstmt's parameter \uC14B\uD305&\#13;\r\n\t\t\t&\#13;\r\n\t\t\t//4.DB delete&\#13;\r\n\t\t\tres \= pstmt.executeUpdate();&\#13;\r\n\t\t\t&\#13;\r\n&\#13;\r\n\t\t} catch (Exception e) {&\#13;\r\n\t\t\t// TODO\: handle exception&\#13;\r\n\t\t\te.printStackTrace();&\#13;\r\n\t\t} finally {&\#13;\r\n&\#13;\r\n\t\t\ttry {&\#13;\r\n\t\t\t\t//\uC5F4\uB9B0 \uC5ED\uC21C\uC73C\uB85C \uB2EB\uAE30&\#13;\r\n\t\t\t\tif (pstmt \!\= null)&\#13;\r\n\t\t\t\t\tpstmt.close();&\#13;\r\n\t\t\t\tif (conn \!\= null)&\#13;\r\n\t\t\t\t\tconn.close();&\#13;\r\n\t\t\t} catch (SQLException e) {&\#13;\r\n\t\t\t\t// TODO Auto-generated catch block&\#13;\r\n\t\t\t\te.printStackTrace();&\#13;\r\n\t\t\t}&\#13;\r\n\t\t}&\#13;\r\n&\#13;\r\n\t\treturn res;&\#13;\r\n&\#13;\r\n\t}//end\:delete()</template><template autoinsert\="true" context\="java" deleted\="false" description\="" enabled\="true" name\="_forward_servlet">import jakarta.servlet.RequestDispatcher;&\#13;\r\nimport jakarta.servlet.ServletException;&\#13;\r\nimport jakarta.servlet.annotation.WebServlet;&\#13;\r\nimport jakarta.servlet.http.HttpServlet;&\#13;\r\nimport jakarta.servlet.http.HttpServletRequest;&\#13;\r\nimport jakarta.servlet.http.HttpServletResponse;&\#13;\r\nimport java.io.IOException;&\#13;\r\n&\#13;\r\n/**&\#13;\r\n * Servlet implementation class ${primary_type_name}&\#13;\r\n */&\#13;\r\n@WebServlet("/${cursor}")&\#13;\r\npublic class ${primary_type_name} extends HttpServlet {&\#13;\r\n\tprivate static final long serialVersionUID \= 1L;&\#13;\r\n&\#13;\r\n\t/**&\#13;\r\n\t * @see HttpServlet\#service(HttpServletRequest request, HttpServletResponse response)&\#13;\r\n\t */&\#13;\r\n\tprotected void service(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {&\#13;\r\n\t\t// TODO Auto-generated method stub&\#13;\r\n\t\t&\#13;\r\n\t\t&\#13;\r\n\t\t&\#13;\r\n\t\t// Dispatcher(forward)&\#13;\r\n\t\tString forward_page \= "[\uD3EC\uC6CC\uB4DC\uD398\uC774\uC9C0].jsp";&\#13;\r\n\t\tRequestDispatcher disp \= request.getRequestDispatcher(forward_page);&\#13;\r\n\t\tdisp.forward(request, response);&\#13;\r\n\t\t&\#13;\r\n\t}&\#13;\r\n}&\#13;\r\n</template><template autoinsert\="true" context\="java" deleted\="false" description\="" enabled\="true" name\="_insert">\t// \uCD94\uAC00&\#13;\r\n\tpublic int insert(${argType} vo) {&\#13;\r\n&\#13;\r\n\t\tint res \= 0;&\#13;\