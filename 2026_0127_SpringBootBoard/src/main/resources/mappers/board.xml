<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bbs.dao.BoardDao">

 <!-- 전체조회 -->
  <select id="selectList" resultType="board">
  	select * from board order by b_ref desc, b_step asc
  </select>

<!-- b_idx 이용한 BoardVo 객체 1개 얻기 -->
<select id="selectOneFromIdx" parameterType="int"
								resultType="board">
	select * from board where b_idx=#{ b_idx }

</select>

<!-- mem_id 이용한 boardVo 객체 1개 얻기 -->

<select id="selectOneFromMemId" parameterType="String"
								resultType="board">
	select * from board where mem_id=#{ mem_id }

</select>

<!-- 추가 -->
<insert id="insert" parameterType="board">

insert into board values(
							seq_board_b_idx.nextVal,
 							#{b_subject},
							#{b_content} ,							
							#{b_ip} ,							
							#{b_readhit} ,							
							#{b_regdate} ,							
							#{b_moddate} ,							
							#{mem_idx} ,							
							#{mem_id} ,							
							#{b_ref} ,							
							#{b_step} ,							
							#{b_depth} ,							
							default 
 							 )
</insert>

<!-- 수정
<update id="update" parameterType="board">
update board set 	b_subject		=		#{b_subject},
							b_content = #{b_content} ,							
							#{b_moddate} ,													
							default 
	where b_idx=#{b_idx}
</update>
-->

<!-- 삭제 
<delete id="delete" parameterType="int">
	delete from board where b_idx=#{ b_idx }
</delete>
-->
</mapper>












